# Modèle du fichier .env.
# - En local (votre PC) : copiez-le en .env et remplissez-le (il n'est jamais commité).
# - En production : son contenu va dans le secret GitHub ENV_PRODUCTION. Le workflow de
#   déploiement ajoute lui-même GHCR_OWNER et DOMAINE.
# Générer un mot de passe : openssl rand -hex 20   (lettres et chiffres uniquement)

# Mot de passe du compte "app" utilisé par les microservices dans CHAQUE base
DB_PASSWORD=a-remplacer

# Mot de passe administrateur (root) des conteneurs MongoDB
MONGO_ROOT_PASSWORD=a-remplacer

# --- Uniquement en local (le déploiement les calcule tout seul) ---
GHCR_OWNER=mon-organisation
DOMAINE=:80
